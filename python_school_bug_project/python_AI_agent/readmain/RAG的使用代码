    messages.append({"role": "user", "content": content})

    # 处理 tool_calls (如果模型决定调用工具)
    # 注意：如果模型调用工具，它看到的上下文是包含注入知识的
    end_chat_push = call_function(message_from_model) # call_function 内部会更新全局 messages
    return end_chat_push


#这里的是处理tools中有输出的情况,来调用外部的tools
def call_function(message):
    # 判断是否有 tool_calls，进行方法的调用
    entire_ResponseText = ''
    if "tool_calls" in message and message["tool_calls"]:
        for call in message["tool_calls"]:
            function_name = call["function"]["name"]
            args_str = call["function"]["arguments"]
            args = json.loads(args_str)
            
            tool_response_content = ""
            tool_used_info = ""

            if function_name == "get_weather":
                city = args["city"]
                tool_name, weather_info = get_weather(city)
                tool_response_content = weather_info
                tool_used_info = f"调用 get_weather({city}) 使用了：{tool_name}大模型，结果：{weather_info}"
            elif function_name == "get_dbData":
                databaseName = args["databaseName"]
                tableName = args["tableName"]
                measures_list = args["measures"]
                tool_name, db_data = get_dbData(databaseName, tableName, measures_list)
                tool_response_content = db_data
                tool_used_info = f"调用 get_dbData({databaseName}, {tableName}, {measures_list}) 使用了：{tool_name}大模型，结果：{db_data}"
            elif function_name == "get_item_compare":
                file_paths = args["file_path"]
                measure_code = args["measures"]
                tool_name, thinking_process, product_reason = get_item_compare(file_paths, measure_code)
                tool_response_content = product_reason # 或者包含 thinking_process
                tool_used_info = f"调用 get_item_compare({file_paths}, {measure_code}) 使用了：{tool_name}大模型，推荐原因：{product_reason}"
            else:
                tool_used_info = f"未知的工具函数调用: {function_name}"
                tool_response_content = "无法处理此工具调用。"

            # 将工具调用的结果反馈给模型（如果需要多轮工具调用）或直接作为最终回复的一部分
            # 根据 SiliconFlow 的文档，工具调用的结果应该作为新的 assistant message 发回
            # 这里我们简化处理，直接将工具执行信息加入到 entire_ResponseText
            # 并且将工具的直接输出（tool_response_content）加入到全局 messages 的 assistant 回复中
            messages.append({
                "role": "tool", 
                "tool_call_id": call['id'], 
                "name": function_name, 
                "content": tool_response_content
            })
            entire_ResponseText += tool_used_info + "\n"
        
        # 如果有工具调用，通常需要将工具结果再发给模型获取最终回复
        # 但你当前的设计是直接返回工具执行的总结，这里保持这个逻辑
        # 如果要让模型基于工具结果再总结，需要再次调用 tongyi_chat (或类似API)
        # 并将 role:tool 的消息加入到 api_messages 中
        final_summary = "工具调用执行完毕。\n" + entire_ResponseText
        messages.append({"role": "assistant", "content": final_summary}) # 记录助手对工具调用的总结
        return final_summary
    else:
        ai_response = message.get("content", "")
        messages.append({"role": "assistant", "content": ai_response})
        return "没有调用任何工具，模型直接给出了回答：\n"+ ai_response

