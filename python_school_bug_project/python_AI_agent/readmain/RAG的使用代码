messages = [] # 保持你原有的对话历史

def retrieve_from_knowledge_base(query_text):
    """从向量知识库中检索相关信息"""
    if not ragg_embedding_model or not ragg_knowledge_collection:
        return [] # RAG未初始化则不进行检索
    try:
        query_embedding = ragg_embedding_model.encode(query_text).tolist()
        results = ragg_knowledge_collection.query(
            query_embeddings=[query_embedding],
            n_results=KNOWLEDGE_RETRIEVAL_TOP_K,
            include=['documents'] # 我们只需要文档内容
        )
        # results['documents'] 是一个列表的列表，因为可以批量查询
        # 对于单个查询，我们取第一个列表
        retrieved_docs = results['documents'][0] if results['documents'] and results['documents'][0] else []
        print(f"Retrieved {len(retrieved_docs)} snippets from knowledge base for query: '{query_text}'")
        return retrieved_docs
    except Exception as e:
        print(f"Error during knowledge base retrieval: {e}")
        return []

def tongyi_chat(content, url, key):
    global messages

    # 1. RAG: 从知识库检索相关信息
    retrieved_snippets = retrieve_from_knowledge_base(content)

    # 2. RAG: 构建增强的 Prompt
    # 用户的原始问题仍然是主要的，知识片段作为补充上下文
    api_messages = []
    
    # 你可以调整 system prompt 来指导模型如何使用知识
    system_message_content = "你是一个智能助手。请参考以下可能相关的背景知识来回答用户的问题。如果背景知识与问题无关，请忽略它们并正常回答。"
    api_messages.append({"role": "system", "content": system_message_content})

    if retrieved_snippets:
        knowledge_prompt_part = "背景知识参考：\n"
        for i, snippet in enumerate(retrieved_snippets):
            knowledge_prompt_part += f"{i+1}. {snippet}\n"
        # 将知识和问题组合，可以放在一个 user message 里，或者知识作为 system/assistant message
        # 这里选择将知识作为用户提问的一部分前缀
        api_messages.append({"role": "user", "content": knowledge_prompt_part + "\n用户问题：" + content})
    else:
        api_messages.append({"role": "user", "content": content}) # 没有知识，直接提问
    
    # 如果你的模型支持多轮对话，并且你希望它记住之前的RAG上下文，
    # 你需要更复杂地管理 messages 列表，将之前的对话历史（包括可能已注入的知识）也传给API。
    # 为简单起见，此示例中每次API调用都基于当前问题和新检索的知识构建 api_messages。
    # 但全局的 `messages` 列表仍然用于维护用户和助手之间的完整对话历史。

    payload = {
        "model": "Qwen/Qwen3-8B",
        "messages": api_messages, # 使用为API构建的messages
        "stream": False,
        "max_tokens": 1024, # 可能需要增加max_tokens以容纳知识和答案
        "enable_thinking": True,
        "thinking_budget": 4096,
        "min_p": 0.05,
        "stop": [],
        "temperature": 0.7,
        "top_p": 0.7,
        "top_k": 50,
        "frequency_penalty": 0.5,
        "n": 1,
        "response_format": {"type": "text"},
        "tools": [ # 你原有的 tools 定义
            {
                "type": "function",
                "function": {
                    "description": "获取指定城市的详细天气信息",
                    "name": "get_weather",
                    "parameters": {
                        "city" :{
                            "type": "string",
                            "description": "城市名称"
                        }
                    },
                    "strict": True
                }
            },
            {
                "type": "function",
                "function": {
                    "description": "对指定数据库进行操作，如果是不同的数据库则需要多次调用这个函数，但如果是同一个数据库的操作的话就执行一次就好",
                    "name": "get_dbData",
                    "parameters": {
                        "databaseName": {
                            "type": "string",
                            "description": "数据库名"
                        },
                        "tableName": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "表名（这里将需要操作的表名一一放入这个数组中）"
                        },
                        "measures": {
